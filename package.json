{
  "name": "vivere",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev": "vp dev",
    "build": "vp build",
    "lint": "effect-tsgo vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "effect-tsgo tsc --noEmit",
    "test": "vp test run",
    "check": "effect-tsgo vp check && effect-tsgo tsc --noEmit && vp test run && bun run server:check",
    "preview": "vp preview",
    "effect:topics": "effect-solutions list",
    "effect:guide": "effect-solutions show",
    "server:fmt:check": "cd server && test -z \"$(gofmt -l .)\"",
    "server:vet": "cd server && go vet ./...",
    "server:test": "cd server && go test -race ./...",
    "server:check": "bun run server:fmt:check && bun run server:vet && bun run server:test"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.1.5",
    "pixi.js": "^8.23.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "untitled-pixi-live2d-engine": "^1.4.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.73.4",
    "@effect/vitest": "^4.1.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "effect-solutions": "0.5.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
}
